# ===========================================================================
# Repo-level ignores — this file is the single source of truth.
# (Nested .gitignore files in knowledgetree/ etc. are kept for tooling, but
#  everything needed to keep the repo clean is listed here too.)
# ===========================================================================

# --- Local reference backup (read-only, never push) ---
backup/

# --- Python (python-serv) ---
python-serv/env/
python-serv/config.json          # holds api_key / secrets
python-serv/.temp
python-serv/*.log
__pycache__/
*.pyc
*.pyo

# --- Flutter (knowledgetree) generated build output ---
knowledgetree/build/
knowledgetree/.dart_tool/
knowledgetree/.metadata
knowledgetree/.flutter-plugins-dependencies
knowledgetree/linux/flutter/ephemeral/
knowledgetree/ios/Flutter/ephemeral/
knowledgetree/macos/Flutter/ephemeral/
knowledgetree/windows/flutter/ephemeral/
knowledgetree/android/.gradle/

# --- IDE / editor files ---
.idea/
*.iml
*.ipr
*.iws
.DS_Store
